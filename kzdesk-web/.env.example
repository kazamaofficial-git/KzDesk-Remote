# Salin ke .env lalu isi. Jalankan dengan: node --env-file=.env src/index.js
PORT=3000
BASE_URL=https://kzdesk.kazamasite.biz.id
# Reverse proxy (nginx/Caddy/Cloudflare) di depan server? Isi jumlah hop, mis. 1.
TRUST_PROXY=1
DATA_DIR=./data
# Repo GitHub tempat APK + installer host dirilis
GITHUB_REPO=kazamadev/KzDesk-Remote
# Opsional: token read-only agar tidak kena rate limit GitHub API
GITHUB_TOKEN=
# Wajib diisi bila ingin memakai PUT /api/admin/release-state
ADMIN_TOKEN=
DONATE_URL=https://www.kazamasite.biz.id/donate

# ---- Push notification (opsional) -------------------------------------------
# Android (FCM HTTP v1): unduh JSON akun layanan dari Firebase Console > Project settings > Service accounts.
FCM_SERVICE_ACCOUNT_FILE=
# atau isi manual:
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# iOS (APNs, kunci .p8 dari Apple Developer > Keys). Butuh akun Apple Developer berbayar.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_FILE=
APNS_BUNDLE_ID=com.kazamatech.kzdesk
# false = server APNs sandbox (build debug), true = production (TestFlight/App Store)
APNS_PRODUCTION=true
